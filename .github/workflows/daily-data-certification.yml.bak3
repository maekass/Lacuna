name: Daily Data Certification

on:
  # Run daily at 6 AM UTC
  schedule:
    - cron: '0 6 * * *'
  
  # Allow manual trigger
  workflow_dispatch:
  
  # Run on push to main (for testing)
  push:
    branches:
      - main
    paths:
      - 'data/processed/**'
      - 'scripts/generate_data_certification.py'

jobs:
  certify-data:
    runs-on: ubuntu-latest
    
    permissions:
      contents: write
      issues: write
      pull-requests: write
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'
      
      - name: Install dependencies
        run: |
          pip install pandas requests
      
      - name: Run Data Certification
        id: certification
        run: |
          echo "Running daily data certification check..."
          python3 scripts/generate_data_certification.py > certification_output.txt 2>&1
          CERT_EXIT_CODE=$?
          
          # Extract certification hash
          CERT_HASH=$(grep -o "Certification Hash: [A-F0-9]*" certification_output.txt | cut -d' ' -f3 || echo "UNKNOWN")
          
          echo "exit_code=$CERT_EXIT_CODE" >> $GITHUB_OUTPUT
          echo "cert_hash=$CERT_HASH" >> $GITHUB_OUTPUT
          
          # Show output
          cat certification_output.txt
          
          exit $CERT_EXIT_CODE
      
      - name: Check Certification Status
        if: always()
        run: |
          if [ "${{ steps.certification.outputs.exit_code }}" -eq "0" ]; then
            echo "PASSED: Certification successful"
            echo "Hash: ${{ steps.certification.outputs.cert_hash }}"
          else
            echo "FAILED: Certification did not pass"
            exit 1
          fi
      
      - name: Commit Updated Certificate
        if: success()
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          
          # Check if certificate files changed
          if git diff --quiet DATA_VERIFICATION_CERTIFICATE.md DATA_VERIFICATION_CERTIFICATE.json; then
            echo "No changes to certificate files"
          else
            git add DATA_VERIFICATION_CERTIFICATE.md DATA_VERIFICATION_CERTIFICATE.json
            git commit -m "chore: Update daily data certification [skip ci]

Automated daily certification check
Date: $(date -u +"%Y-%m-%d %H:%M UTC")
Hash: ${{ steps.certification.outputs.cert_hash }}
Status: PASSED"
            git push
          fi
      
      - name: Create Issue on Failure
        if: failure()
        uses: actions/github-script@v7
        with:
          script: |
            const title = 'ALERT: Daily Data Certification Failed';
            const body = `## Data Certification Failed
            
            **Date:** ${new Date().toUTCString()}
            **Workflow:** [${context.workflow}](${context.payload.repository.html_url}/actions/runs/${context.runId})
            
            ### Details
            
            The automated daily data certification check has failed. This means one or more of the following tests did not pass:
            
            - ❌ Clinical Trials Verification (6,819 trials)
            - ❌ Epidemiology Data Verification (15 diseases)
            - ❌ FDA Drug Approval Verification (535 drugs)
            - ❌ Synthetic Data Absence Check
            - ❌ Quality Score Verification (>= 90/100)
            
            ### Action Required
            
            1. Review the [workflow logs](${context.payload.repository.html_url}/actions/runs/${context.runId})
            2. Run certification locally: \`./verify_data.sh\`
            3. Investigate and fix the issue
            4. Re-run the workflow
            
            ### Possible Causes
            
            - Data files were modified or corrupted
            - ClinicalTrials.gov API is down
            - Synthetic data was accidentally added
            - Quality score dropped below threshold
            - Network/API timeout issues
            
            **This issue was automatically created by the daily certification workflow.**
            `;
            
            // Check if issue already exists
            const issues = await github.rest.issues.listForRepo({
              owner: context.repo.owner,
              repo: context.repo.repo,
              state: 'open',
              labels: ['data-certification', 'automated']
            });
            
            if (issues.data.length === 0) {
              await github.rest.issues.create({
                owner: context.repo.owner,
                repo: context.repo.repo,
                title: title,
                body: body,
                labels: ['data-certification', 'automated', 'bug']
              });
            }
      
      - name: 📈 Upload Certification Report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: certification-report-${{ github.run_number }}
          path: |
            DATA_VERIFICATION_CERTIFICATE.md
            DATA_VERIFICATION_CERTIFICATE.json
            certification_output.txt
          retention-days: 90
      
      - name: 🎉 Post Success Comment
        if: success() && github.event_name == 'push'
        uses: actions/github-script@v7
        with:
          script: |
            const message = `## ✅ Data Certification Passed
            
            **Hash:** \`${{ steps.certification.outputs.cert_hash }}\`
            **Date:** ${new Date().toUTCString()}
            
            All data quality checks passed:
            - ✅ 6,819 clinical trials verified
            - ✅ 15 diseases with epidemiology data
            - ✅ 535 FDA drugs verified
            - ✅ Zero synthetic data
            - ✅ Quality score: 99.96/100
            
            [View Certificate](${context.payload.repository.html_url}/blob/main/DATA_VERIFICATION_CERTIFICATE.md)
            `;
            
            // Find the most recent commit
            const commits = await github.rest.repos.listCommits({
              owner: context.repo.owner,
              repo: context.repo.repo,
              per_page: 1
            });
            
            if (commits.data.length > 0) {
              await github.rest.repos.createCommitComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                commit_sha: commits.data[0].sha,
                body: message
              });
            }

  # Summary job
  certification-summary:
    runs-on: ubuntu-latest
    needs: certify-data
    if: always()
    
    steps:
      - name: 📊 Certification Summary
        run: |
          echo "=================================="
          echo "DAILY DATA CERTIFICATION SUMMARY"
          echo "=================================="
          echo ""
          echo "Date: $(date -u +"%Y-%m-%d %H:%M UTC")"
          echo "Status: ${{ needs.certify-data.result }}"
          echo ""
          
          if [ "${{ needs.certify-data.result }}" == "success" ]; then
            echo "✅ All data quality checks passed"
            echo "✅ Certificate updated"
            echo "✅ Data integrity confirmed"
          else
            echo "❌ Data certification failed"
            echo "⚠️  Issue created for investigation"
            echo "⚠️  Review workflow logs"
          fi
