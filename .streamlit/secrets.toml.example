# Streamlit Secrets Template
# Copy this file to secrets.toml and add your actual values
# DO NOT commit secrets.toml to git

# Example API keys (if needed in future)
# [api_keys]
# clinicaltrials_api_key = "your_key_here"
# openai_api_key = "your_key_here"

# Example database credentials (if needed)
# [database]
# host = "localhost"
# port = 5432
# database = "immunology_db"
# username = "user"
# password = "password"
