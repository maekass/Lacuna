# Lacuna — copy to .env.local and fill in values.
# Product demo defaults work with no env vars (static JSON dataset).

# --- Data mode ---
# static (default) | db — requires Postgres + npm run db:migrate && npm run db:import
LACUNA_DATA_MODE=static

# --- PostgreSQL (db mode, SEC ingest, ingest status) ---
# Local: docker compose up -d && use connection below
# Neon restore: npm run db:restore -- --url "postgresql://..."  (see docs/RESTORE_POSTGRES.md)
DATABASE_URL=postgresql://lacuna:lacuna@localhost:5432/lacuna
# disable = no TLS (local Docker). Otherwise certificates are verified.
PGSSLMODE=disable
# Path to a CA file, or an inline PEM (including escaped \n).
# PGSSLROOTCERT=
# Escape hatch only — disables cert verification and logs a warning.
# PGSSL_ALLOW_UNVERIFIED=true
PG_POOL_MAX=3

# --- Deal promotion (approved staging → verified dataset) ---
# Unattended weekly pipeline (GitHub Action + optional Vercel cron chaining)
LACUNA_HANDS_OFF_INGEST=false
# high (default) | medium — auto-approve threshold when hands-off is on
LACUNA_AUTO_APPROVE_CONFIDENCE=high
# json | db | both — promotion sink (GitHub Action uses both)
LACUNA_PROMOTE_TARGET=both
# true = auto-promote immediately when a deal is approved via review API
LACUNA_AUTO_PROMOTE=false

# --- Vercel cron (production) ---
# Vercel sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Deal review API (production) ---
# Preferred: GitHub OAuth allowlist (see docs/REVIEW_CONSOLE.md)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LACUNA_REVIEW_GITHUB_ALLOWLIST=
# Optional override; default is {origin}/api/deals/review/github/callback
LACUNA_REVIEW_OAUTH_REDIRECT_URI=
# HMAC session signing (falls back to CRON_SECRET / LACUNA_REVIEW_API_KEY)
LACUNA_REVIEW_SESSION_SECRET=
# Bearer token fallback for CLI / automation (falls back to CRON_SECRET)
LACUNA_REVIEW_API_KEY=
# true = allow read-only review UI on Vercel without unlocking (portfolio demo
# only — approve/reject/import/promote still require sign-in)
LACUNA_REVIEW_UI_PUBLIC=false

# --- SEC EDGAR ingest (8-K Item 2.01) ---
SEC_EDGAR_USER_AGENT="Lacuna Research mps5cy@virginia.edu"
SEC_SCAN_SINCE=
SEC_LIMIT_PER_TICKER=
SEC_EXTRA_TICKERS=
# TICKER:CIK pairs for symbols missing from SEC company_tickers.json (e.g. HOLX:859737)
SEC_TICKER_CIK_OVERRIDES=
SEC_HEALTHCARE_SIC_ONLY=false
# Production (Vercel cron): cap per weekly run — see docs/VERCEL_SETTINGS.md
SEC_MAX_TICKERS_PER_RUN=50
SEC_MAX_PARSED_FILINGS_PER_RUN=100
SEC_USE_DB_CURSOR=true
SEC_CLASSIFY_CONCURRENCY=3
LACUNA_INGEST_RUN_TRACKING=true

# --- SEC Form D ingest (optional CLI) ---
SEC_FORM_D_SINCE=
SEC_FORM_D_MAX_RESULTS=50
SEC_FORM_D_PARSE_CONCURRENCY=2
# true = store non-WH Form D filings (default skips them)
SEC_FORM_D_SYNC_ALL=false

# --- SEC EFTS M&A ingest (optional CLI) ---
SEC_EFTS_SINCE=
SEC_EFTS_MAX_RESULTS=50

# --- Free API batch downloader (npm run download:free-apis) ---
NCBI_TOOL_EMAIL=mps5cy@virginia.edu
# Optional — free registration at https://search.patentsview.org/
PATENTSVIEW_API_KEY=

# --- AI (optional — SEC classification + /api/ai/insights) ---
# Priority: AI_GATEWAY_API_KEY → VERCEL_OIDC_TOKEN → OPENAI_API_KEY → keyword-only
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
OPENAI_API_KEY=

# --- Patient data governance (HIPAA/GDPR — genomics only) ---
# de_identified (default) | authorized | blocked
LACUNA_PATIENT_DATA_MODE=de_identified
LACUNA_PATIENT_DATA_API_KEY=
LACUNA_INGEST_CONSENT_REF=

# --- Variant call-set store (optional — off on Vercel demo) ---
# Multi-GB VCF blobs → object storage; ClickHouse holds queryable variant summaries.
LACUNA_VARIANT_STORE=off
CLICKHOUSE_URL=http://lacuna:lacuna@localhost:8123
CLICKHOUSE_DATABASE=lacuna
# local (default) | s3
LACUNA_OBJECT_STORAGE=local
LACUNA_OBJECT_STORAGE_LOCAL_ROOT=data/variants
LACUNA_S3_BUCKET=
LACUNA_S3_REGION=us-east-1

# --- Rate limiting (production — Upstash Redis via Vercel Marketplace) ---
# Unset locally → in-memory fallback (not durable across serverless instances)
# Get credentials from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Audit sink (genomics patient-data access) ---
# SHA-256 salt for actor hashing in audit logs (production required)
LACUNA_AUDIT_SALT=

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Next.js API proxy (optional — route /api/* to external backend) ---
API_PROXY_ORIGIN=

# --- Python FastAPI sidecar (optional — local / self-hosted) ---
# REST + GraphQL on port 8000. Not deployed on Vercel demo.
# Start: npm run python-api:dev  OR  docker compose --profile api up -d
LACUNA_DATASET_PATH=src/data/dataset.verified.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- .NET EF Core sidecar (optional — local / self-hosted) ---
# REST + Swagger on port 8001. Not deployed on Vercel demo.
# Start: npm run dotnet-api:dev  OR  docker compose --profile dotnet-api up -d
# Uses DATABASE_URL above for EF Core research_studies queries.
