{
  "expo": {
    "name": "Lacuna",
    "slug": "lacuna-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lacuna-mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf7f8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.replit.lacunamobile"
    },
    "android": {
      "package": "com.replit.lacunamobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
