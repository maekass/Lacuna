{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Streamlit: dashboard (port 8501)",
      "type": "shell",
      "command": "streamlit run dashboard/app.py --server.address 0.0.0.0 --server.port 8501",
      "options": {
        "cwd": "${workspaceFolder}"
