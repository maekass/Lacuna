{
  "name": "lacuna",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "prepare": "husky",
    "deno:lint": "npx --yes deno@2.1.4 lint src scripts",
    "deno:fmt": "npx --yes deno@2.1.4 fmt",
    "deno:fmt:check": "npx --yes deno@2.1.4 fmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:dataset": "tsx scripts/validate-dataset.ts",
    "validate:empowerment": "tsx scripts/validate-empowerment.ts",
    "compute:dataset-summary": "tsx scripts/compute-dataset-summary.ts",
    "compute:benchmarks": "tsx scripts/compute-benchmarks.ts",
    "compute:growth-rates": "tsx scripts/compute-growth-rates.ts",
    "compute:acquirer-premiums": "tsx scripts/compute-acquirer-premiums.ts",
    "compute:sector-correlations": "tsx scripts/compute-sector-correlations.ts",
    "compute:data-quality": "tsx scripts/compute-data-quality.ts",
    "compute:confidence-intervals": "tsx scripts/compute-confidence-intervals.ts",
    "compute:all": "tsx scripts/compute-all.ts",
    "ml:ct:seed": "PYTHONPATH=ml/clinical_trials python3 ml/clinical_trials/scripts/generate_seed.py",
    "ml:ct:ingest": "PYTHONPATH=ml/clinical_trials python3 ml/clinical_trials/scripts/ingest_ctgov.py --all-queries",
    "ml:ct:train": "PYTHONPATH=ml/clinical_trials python3 ml/clinical_trials/scripts/train_all.py",
    "ml:ct:corpus": "PYTHONPATH=ml/clinical_trials python3 ml/clinical_trials/scripts/export_llm_corpus.py",
    "verify:computed": "tsx scripts/verify-computed-artifacts.ts",
    "build:endometriosis-coverage": "tsx scripts/build-endometriosis-coverage.ts",
    "build:endometrial-cancer-coverage": "tsx scripts/build-endometrial-cancer-coverage.ts",
    "sec:scan": "tsx scripts/sec-scan-acquirers.ts",
    "sec:ingest": "tsx scripts/sec-ingest-deals.ts",
    "pipeline:weekly": "tsx scripts/weekly-deal-pipeline.ts",
    "sec:ingest-form-d": "tsx scripts/sec-ingest-form-d.ts",
    "sec:search-ma": "tsx scripts/sec-search-ma.ts",
    "sec:ingest-efts": "tsx scripts/sec-ingest-efts.ts",
    "review-console:stack": "tsx scripts/review-console-stack.ts",
    "deals:import-csv": "tsx scripts/import-deals-candidates-csv.ts",
    "sec:form-d-bulk": "tsx scripts/download-sec-form-d-bulk.ts",
    "download:cms-bulk": "tsx scripts/download-cms-bulk.ts",
    "download:aact": "sh scripts/download-aact.sh",
    "ml:ct:aact:link": "sh scripts/aact-link-snapshot.sh",
    "ml:ct:aact:load": "sh scripts/aact-load.sh",
    "ml:ct:aact:export": "PYTHONPATH=ml/clinical_trials python3 ml/clinical_trials/scripts/export_from_aact.py",
    "download:free-apis": "tsx scripts/download-free-apis.ts",
    "payer-ops:benchmarks:fetch": "tsx scripts/fetch-payer-ops-benchmarks.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import": "tsx scripts/import-verified-json.ts",
    "db:restore": "tsx scripts/restore-postgres.ts",
    "db:ping": "tsx scripts/restore-postgres.ts --check",
    "deals:promote-approved": "tsx scripts/promote-approved-deals.ts",
    "db:seed-research": "tsx scripts/seed-research-studies.ts",
    "clickhouse:migrate": "tsx scripts/clickhouse-migrate.ts",
    "clickhouse:seed": "tsx scripts/seed-variant-callsets.ts",
    "clickhouse:ingest-vcf": "tsx scripts/ingest-vcf-stream.ts",
    "ingest:worker": "tsx services/ingest-worker/index.ts",
    "python-api:dev": "cd services/python-api && uvicorn app.main:app --reload --port 8000",
    "python-api:test": "cd services/python-api && python -m pytest",
    "dotnet-api:dev": "cd services/dotnet-api && dotnet watch run --project Lacuna.DotNetApi --urls http://localhost:8001",
    "dotnet-api:test": "cd services/dotnet-api && dotnet test",
    "infra:check": "tsx scripts/infra-check.ts",
    "monitor:liveness": "sh scripts/monitor-liveness.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "@aws-sdk/client-s3": "^3.1064.0",
    "@aws-sdk/s3-request-presigner": "^3.1064.0",
    "@clickhouse/client": "^1.20.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@sentry/nextjs": "^10.55.0",
    "@types/d3": "^7.4.3",
    "@upstash/redis": "^1.38.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.193",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pg": "^8.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "simple-statistics": "^7.8.9",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@storybook/nextjs": "^9.1.20",
    "@storybook/react": "^9.1.20",
    "@tailwindcss/postcss": "^4",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "storybook": "^9.1.20",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
