.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.streamlit/secrets.toml

# Ignore CSV files by default
*.csv
!data/demo/
!data/demo/**
!data/demo/**/*.csv
!data/processed/
!data/processed/**
!data/processed/**/*.csv
!data/processed/**/*.json
!data/demo/quant/
!data/demo/quant/**
!data/processed/quant/
!data/processed/quant/**

# Ignore large HTML visualization files (regenerate with scripts)
data/visualizations/*.html

# Allow models but ignore large ones
!data/models/
!data/models/**

# Other ignores
!data/raw/.gitkeep
data/raw/data_manifest.json
data/raw/provenance_log.jsonl
data/validation_report.txt
data/validation_report.json
.ipynb_checkpoints/
