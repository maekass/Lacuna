{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/sec-ingest",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/dataset-summary",
      "schedule": "30 6 * * 1"
    }
  ]
}
